                <mxCell id="flux3" edge="1" parent="1" source="f-services" style="html=1;endArrow=classic;startArrow=classic;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" target="b-controleurs" value="&lt;b&gt;API REST · JSON&lt;/b&gt;&lt;br&gt;upload : multipart/form-data&lt;br&gt;téléchargement : flux du fichier&lt;br&gt;JWT dans l’en-tête Authorization">
