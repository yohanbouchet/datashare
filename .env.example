# =====================================================================
# Variables d'environnement de DataShare (racine du projet)
# Lues par Docker Compose (service "db") ET par l'API NestJS (backend/).
# MODÈLE publié sur GitHub : copier en .env (cp .env.example .env) puis remplir.
# =====================================================================

# --- Base de données PostgreSQL --------------------------------------
# Adresse de la base vue depuis l'API : "localhost" quand l'API tourne
# sur la machine, "db" (nom du service Compose) si l'API tourne dans Docker.
POSTGRES_HOST=localhost
# Port publié par le conteneur (limité à 127.0.0.1 dans docker-compose.yml).
POSTGRES_PORT=5432
# Nom de la base et compte de connexion, créés au premier démarrage du conteneur.
POSTGRES_DB=datashare
POSTGRES_USER=datashare
# Mot de passe du compte : à changer, ne jamais le publier.
POSTGRES_PASSWORD=change-moi

# --- API NestJS --------------------------------------------------------
# Seule origine autorisée par le CORS : l'adresse du front-end React.
FRONTEND_URL=http://localhost:5173
