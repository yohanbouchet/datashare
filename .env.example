# =====================================================================
# Variables d'environnement de DataShare (racine du projet)
# Lues par Docker Compose (service "db") ET par l'API NestJS (backend/).
# MODÈLE publié sur GitHub : copier en .env (cp .env.example .env) puis remplir.
# =====================================================================

# --- Base de données PostgreSQL --------------------------------------
# Adresse de la base vue depuis l'API : "localhost" quand l'API tourne
# sur la machine, "db" (nom du service Compose) si l'API tourne dans Docker.
POSTGRES_HOST=localhost
# Port publié par le conteneur (limité à 127.0.0.1 dans docker-compose.yml).
POSTGRES_PORT=5432
# Nom de la base et compte de connexion, créés au premier démarrage du conteneur.
POSTGRES_DB=datashare
POSTGRES_USER=datashare
# Mot de passe du compte : à changer, ne jamais le publier.
POSTGRES_PASSWORD=change-moi

# --- API NestJS --------------------------------------------------------
# Seule origine autorisée par le CORS : l'adresse du front-end React.
FRONTEND_URL=http://localhost:5173

# --- Authentification (JWT) ------------------------------------------
# Clé de signature des JWT : longue et aléatoire. 🔒 Si elle fuit, n'importe qui peut fabriquer un jeton.
JWT_SECRET=change-moi-avec-une-cle-aleatoire
# Durée de validité d'un JWT (1h = 1 heure)
JWT_EXPIRES_IN=1h

# --- Stockage des fichiers -------------------------------------------
# Dossier où l'API range les fichiers déposés (sous un nom généré, jamais le nom d'origine).
# Chemin relatif au dossier backend/ (d'où l'API est lancée) : uploads → backend/uploads/.
# Exclu de Git (.gitignore : uploads/). En production : un volume Docker.
UPLOAD_DIR=uploads
# Extensions refusées au téléversement (US01), séparées par des virgules : fichiers exécutables ou scripts.
FORBIDDEN_EXTENSIONS=.exe,.msi,.bat,.cmd,.com,.scr,.ps1,.vbs,.js,.jar,.sh

# --- Purge des fichiers expirés (US10) ----------------------------------
# Fréquence de la tâche automatique qui supprime les fichiers expirés (base
# et disque), en minutes. Elle s'exécute aussi une fois au démarrage de l'API.
PURGE_INTERVAL_MINUTES=60
