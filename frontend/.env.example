# =====================================================================
# Variables d'environnement du front-end React (lues par Vite)
# MODÈLE publié sur GitHub : copier en .env (cp .env.example .env).
# Seules les variables préfixées VITE_ sont transmises au navigateur :
# n'y mettre AUCUN secret, tout ce qui est ici est visible par l'utilisateur.
# Vite lit ce fichier au démarrage : relancer "npm run dev" après une modification.
# =====================================================================

# Adresse de base de l'API NestJS (préfixe /api compris).
VITE_API_URL=http://localhost:3000/api
